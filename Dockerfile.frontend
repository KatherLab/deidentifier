### ── Build stage ───────────────────────────────────────────────────
# Runs on the build host's own architecture: the Vite output is static files,
# so only the nginx runtime stage below needs to be multi-arch. This keeps
# Node out of QEMU emulation, which crashes it (SIGILL) on arm64 cross-builds.
FROM --platform=$BUILDPLATFORM node:24-alpine AS builder

WORKDIR /app
# npm ci against the committed lockfile: reproducible, matches what CI tested.
COPY package.json package-lock.json tsconfig.json tsconfig.node.json ./
COPY frontend ./frontend
RUN npm ci && npm run build

### ── Runtime stage (non-root) ──────────────────────────────────────
FROM nginxinc/nginx-unprivileged:stable-alpine

USER root
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY frontend/docker-entrypoint.d/05-resolver.sh /docker-entrypoint.d/05-resolver.sh
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
RUN chown -R 101:101 /usr/share/nginx/html /etc/nginx/conf.d /docker-entrypoint.d/05-resolver.sh \
    && chmod +x /docker-entrypoint.d/05-resolver.sh
USER 101

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
