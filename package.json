{
  "name": "deidentifier",
  "version": "0.4.0",
  "private": true,
  "description": "Deidentifier frontend — anonymize German clinical documents locally.",
  "license": "AGPL-3.0-or-later",
  "author": "KatherLab",
  "type": "module",
  "//typescript": "Pinned to 6.x like llmaixweb: typescript-eslint (8.x) still requires typescript <6.1.0 and vue-tsc has no TS 7 support yet.",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "format": "prettier --write \"frontend/**/*.{js,ts,vue,css}\"",
    "format:check": "prettier --check \"frontend/**/*.{js,ts,vue,css}\"",
    "lint": "eslint frontend/",
    "lint:fix": "eslint frontend/ --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:usage": "node scripts/i18n-usage-check.mjs",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run i18n:check && npm run i18n:usage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.52.0",
    "@tailwindcss/vite": "4.3.3",
    "axios": "1.20.0",
    "fflate": "0.8.3",
    "pinia": "4.0.3",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/message-compiler": "11.4.13",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
