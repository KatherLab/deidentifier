# ============================================================================
# Backend configuration for the Playwright harnesses (e2e smoke + docs
# screenshots). Selected via ENV_PATH=backend/.env.e2e by playwright*.config.ts.
#
# Committed on purpose: it contains no secrets, only local fixtures. A
# developer's own backend/.env (which may point at real endpoints) must never
# leak into an automated run, so the harness always sets ENV_PATH explicitly.
# ============================================================================

APP_ENV=development
APP_MAX_UPLOAD_MB=20
APP_MAX_TEXT_CHARS=500000
APP_ALLOW_INSECURE_CONTENT_LOGGING=false
# Vite runs on 3000 for the smoke test and 3100 for the screenshot harness;
# frontend/services/api.ts talks to http://localhost:8000 directly in dev mode,
# so both origins need to be allowed here.
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100

# The real detector pair, with the LLM pointed at the deterministic fake
# OpenAI-compatible server in e2e/support/fake-llm.mjs — so the harness
# exercises the actual grounding/chunking/re-check code paths, not the mock
# detector's fixed fixture strings.
DETECTORS=rules,llm
OPENAI_API_BASE=http://127.0.0.1:9099/v1
OPENAI_API_KEY=fake-key
LLM_MODEL=fake-model
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_CHUNK_CHARS=16000
LLM_CHUNK_OVERLAP=500
# One pass keeps runs fast and deterministic (the fake model has no variance
# for a second pass to catch).
LLM_DETECTION_PASSES=1
LLM_MAX_CONCURRENT_REQUESTS=4
LLM_RECHECK_ENABLED=true

# No OCR services in the harness: the PDF fixtures carry embedded text.
DOCLING_SERVE_URL=
DOCLING_MIN_EXTRACTED_CHARS_PDF=100
OCR_ENGINE=none
