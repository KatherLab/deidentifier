# ==========================================================================
# Deidentifier configuration
#
#   1. Copy this file:      cp .env.example .env
#   2. Fill in the LLM block below (endpoint + model).
#   3. Start the app:       docker compose up -d --build
#
# Everything else is optional. What every variable does, and when to change
# it: docs/operations/configuration.md  (docs site: Operations - Configuration)
# ==========================================================================

# --- Detection LLM (fill this in) -----------------------------------------
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, a gateway.
# LLM_MODEL must name a model that endpoint actually serves.
#
# In Docker, "localhost" is the backend container itself, not this machine.
#   model server on this machine:      http://host.docker.internal:11434/v1
#   service in this compose project:   http://vllm:8000/v1
#
# While these are empty, production (the Docker default) refuses to start
# and says so in the backend log — a deployment that silently misses names
# is worse than one that does not start.
DETECTORS=rules,llm
OPENAI_API_BASE=
OPENAI_API_KEY=
LLM_MODEL=

# No LLM endpoint yet? DETECTORS=rules starts without one. It finds
# structured identifiers (dates, phone numbers, labelled IDs) but NOT names
# in running prose — enough for a first look, not for real use.

# --- OCR for scanned PDFs (optional) ---------------------------------------
# Off by default: scanned PDFs are rejected with a clear message, native PDFs
# and DOCX/TXT work without any of this. To process scans, point the app at
# an OpenAI-compatible vision model (server recipes for Unlimited-OCR and
# chandra: docs/operations/ocr-engines.md). CPU alternative: OCR_ENGINE=
# docling_tesseract with DOCLING_SERVE_URL set.
# OCR_ENGINE=llm_vision
# VISION_OCR_API_BASE=
# VISION_OCR_API_KEY=
# VISION_OCR_MODEL=
# VISION_OCR_DIALECT=unlimited_ocr     # unlimited_ocr | chandra | plain

# ==========================================================================
# Optional settings. Values shown are the defaults; uncomment to change.
# Reference: docs/operations/configuration.md
# ==========================================================================

# --- Application -----------------------------------------------------------
# APP_ENV=development                  # compose.yml deploys as "production"
# APP_MAX_UPLOAD_MB=20
# APP_MAX_TEXT_CHARS=500000
# APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# APP_ALLOW_INSECURE_CONTENT_LOGGING=false   # DANGEROUS: dev only

# --- Result retention (in memory only; see docs/DATA_RETENTION.md) ---------
# RESULT_CACHE_TTL_MINUTES=15
# RESULT_CACHE_EXTENSION_MINUTES=60
# RESULT_CACHE_MAX_LIFETIME_MINUTES=720
# RESULT_CACHE_MAX_ENTRIES=100

# --- Deployment banner ------------------------------------------------------
# BANNER_ENABLED=true
# BANNER_TEXT='Research Use Only!'
# BANNER_COLOR=amber                   # amber | red | blue | green | gray

# --- LLM detection tuning ---------------------------------------------------
# LLM_REQUEST_TIMEOUT_SECONDS=120
# LLM_CHUNK_CHARS=16000
# LLM_CHUNK_OVERLAP=500
# LLM_DETECTION_PASSES=2
# LLM_MAX_CONCURRENT_REQUESTS=4
# LLM_RECHECK_ENABLED=true

# --- PDF extraction ----------------------------------------------------------
# DOCLING_SERVE_URL=                   # optional docling-serve; empty = local pypdf
# DOCLING_MIN_EXTRACTED_CHARS_PDF=100
# PDF_MAX_PAGES_FOR_TEXT_PROBE=5

# --- Vision OCR details (OCR_ENGINE=llm_vision) ------------------------------
# Prompt/token/body values default to the dialect's recipe — most deployments
# need none of these. Details: docs/operations/ocr-engines.md
# VISION_OCR_PROFILES=                 # several selectable models at once (JSON list)
# VISION_OCR_PROMPT=
# VISION_OCR_FALLBACK_PROMPT=
# VISION_OCR_MAX_TOKENS=
# VISION_OCR_EXTRA_BODY=
# VISION_OCR_TIMEOUT_SECONDS=600
# VISION_OCR_MAX_CONCURRENT_PAGES=2
# VISION_OCR_RENDER_SCALE=2.8          # 2.8 = ~200 dpi

# --- Mistral-OCR API (OCR_ENGINE=mistral_ocr — not implemented yet) ----------
# MISTRAL_API_BASE=
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# --- Docker Compose (read by compose.yml, not by the app) --------------------
# FRONTEND_PORT=8080
# DEIDENTIFIER_IMAGE_TAG=latest        # pin a release for real deployments
