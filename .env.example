# ============================================================================
# German Clinical Document Anonymizer — configuration reference
#
# Copy to .env in the repo root (or point ENV_PATH at another file).
#
# As shipped, this file needs no editing: the app starts with rule-based
# detection and no external services. Every variable is optional — a commented
# line shows the built-in default, which applies until you uncomment it.
# ============================================================================

# --- Quick setup: detectors + LLM endpoint ----------------------------------
# Rules alone find structured identifiers (dates, phone numbers, IBANs,
# labelled IDs) but NOT names in running prose. That is enough to see how the
# app works; it is not enough for real use.
#
# Available detectors: mock | rules | llm — "mock" is for tests/development
# only and is refused in production.
DETECTORS=rules

# For real use, add the LLM detector: uncomment all four lines below and point
# them at any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, a gateway).
# LLM_MODEL must name a model that endpoint actually serves — with "llm" in
# DETECTORS but no endpoint configured, production mode refuses to start and
# development mode fails every request.
# DETECTORS=rules,llm
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_API_KEY=
# LLM_MODEL=

# DOCKER: inside the backend container "localhost" is the container itself,
# not your machine — the value above only works when you run the backend
# directly on the host. From a container, reach:
#   * a service in the same compose project by its name   http://vllm:8000/v1
#   * a server on the Docker host                         http://host.docker.internal:11434/v1
# On Linux, host.docker.internal additionally needs this on the backend
# service in compose.yml:
#   extra_hosts: ["host.docker.internal:host-gateway"]

# ============================================================================
# Everything below is optional. Defaults shown; uncomment to change.
# ============================================================================

# --- Application ------------------------------------------------------------
# development | production | evaluation. Production refuses to start with the
# mock detector or insecure content logging enabled.
# APP_ENV=development
# Upload limit in megabytes (PDF scans can be large).
# APP_MAX_UPLOAD_MB=20
# Maximum extracted text length in characters.
# APP_MAX_TEXT_CHARS=500000
# DANGEROUS: allows document content in logs for local debugging only.
# Prints a prominent warning at startup. Never enable in production.
# APP_ALLOW_INSECURE_CONTENT_LOGGING=false
# Comma-separated allowed CORS origins (the Vite dev server by default).
# APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Result retention -------------------------------------------------------
# How long a finished result stays in the backend's MEMORY so the review UI can
# apply corrections without re-running detection. These are retention settings:
# while an entry lives, a copy of the document is in the process's memory (never
# on disk). Read docs/DATA_RETENTION.md before raising them.
#
# How long a fresh result lasts.
# RESULT_CACHE_TTL_MINUTES=15
# What one press of "Verlängern" grants, from the moment it is pressed.
# Repeatable — a reviewer working on a document keeps it available.
# RESULT_CACHE_EXTENSION_MINUTES=60
# The ceiling no amount of extending can cross, measured from when the result
# was produced. 720 = 12 hours. Lower it if your governance requires it; this
# is the number that makes the retention statement true.
# RESULT_CACHE_MAX_LIFETIME_MINUTES=720
# How many results may be in memory at once (oldest dropped beyond it).
# RESULT_CACHE_MAX_ENTRIES=100
#
# The defaults suit a research prototype. To tighten:
#   - shorter windows       → lower TTL / EXTENSION / MAX_LIFETIME
#   - no extending at all   → MAX_LIFETIME_MINUTES = TTL_MINUTES
#   - the strictest setting → TTL=1, MAX_LIFETIME=1, MAX_ENTRIES=1
# Every one of these only costs speed: an expired result is recomputed from the
# text the browser still holds.

# --- Deployment banner ------------------------------------------------------
# A bar above the header, for deployment-wide notices ("Research Use Only!",
# "Test system — do not use with patient data"). The text is shown verbatim in
# every interface language; it is not translated. Disabled by default; an
# enabled banner with empty text is not displayed.
# BANNER_ENABLED=true
# BANNER_TEXT='Research Use Only!'
# Banner color scheme: amber (default), red, blue, green, or gray. An
# unrecognized value falls back to amber.
# BANNER_COLOR=amber

# --- LLM detection tuning ---------------------------------------------------
# LLM_REQUEST_TIMEOUT_SECONDS=120
# Long documents are split into overlapping chunks (characters).
# LLM_CHUNK_CHARS=16000
# LLM_CHUNK_OVERLAP=500
# Independent detection passes; results are unioned (recall-first safety net
# against run-to-run model variance). Pass 1 runs at temperature 0, further
# passes sample slightly for diversity.
# LLM_DETECTION_PASSES=2
# TOTAL concurrent LLM requests across ALL documents processed in parallel
# (passes x chunks x documents share these slots).
# LLM_MAX_CONCURRENT_REQUESTS=4
# After transformation, the LLM audits the anonymized output for remaining
# PII (warnings only, never edits; adds one more LLM call per document).
# LLM_RECHECK_ENABLED=true

# --- Extraction / OCR --------------------------------------------------------
# docling-serve endpoint for native-PDF conversion. Empty (the default) falls
# back to local pypdf extraction, so no external service is required.
# DOCLING_SERVE_URL=http://localhost:5001
# A PDF page with fewer extractable characters than this is considered scanned.
# DOCLING_MIN_EXTRACTED_CHARS_PDF=100
# PDF_MAX_PAGES_FOR_TEXT_PROBE=5
# OCR engine for scanned PDFs: none | docling_tesseract | mistral_ocr | llm_vision
# "none" (the default) rejects scanned PDFs with a clear message.
# OCR_ENGINE=none

# Mistral-OCR-compatible API (also covers the self-hosted DeepSeek-OCR-2
# stack). Only read when OCR_ENGINE=mistral_ocr.
# MISTRAL_API_BASE=
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# OpenAI-compatible vision model used as OCR. Only read when
# OCR_ENGINE=llm_vision; PDF pages are rendered to PNG and transcribed one
# page at a time.
#
# Recipe for baidu/Unlimited-OCR served by vLLM >= 0.25.0 (note --port 8100:
# the default vLLM port 8000 collides with this backend):
#   docker run --rm --gpus all --network host --ipc host \
#     vllm/vllm-openai:latest baidu/Unlimited-OCR \
#     --port 8100 --trust-remote-code \
#     --logits_processors vllm.model_executor.models.unlimited_ocr:NGramPerReqLogitsProcessor \
#     --no-enable-prefix-caching --mm-processor-cache-gb 0
#   VISION_OCR_API_BASE=http://localhost:8100/v1
#   VISION_OCR_MODEL=baidu/Unlimited-OCR
#   VISION_OCR_EXTRA_BODY={"skip_special_tokens": false, "vllm_xargs": {"ngram_size": 35, "window_size": 128}}
# VISION_OCR_API_BASE=
# VISION_OCR_API_KEY=
# VISION_OCR_MODEL=
# Prompt sent with each page image (Unlimited-OCR recipe by default).
# VISION_OCR_PROMPT=<image>document parsing.
# Retry prompt for a page transcribed to no text while it clearly has ink
# (the layout parser can misclassify a whole page as one image). Empty disables.
# VISION_OCR_FALLBACK_PROMPT=<image>Free OCR.
# VISION_OCR_MAX_TOKENS=8192
# Raw JSON merged into each request body; empty = none.
# VISION_OCR_EXTRA_BODY=
# VISION_OCR_TIMEOUT_SECONDS=600
# TOTAL concurrent OCR page requests across ALL documents in parallel.
# VISION_OCR_MAX_CONCURRENT_PAGES=2
# Page render scale: 1.0 = 72 dpi, 2.8 = ~200 dpi.
# VISION_OCR_RENDER_SCALE=2.8

# --- Docker Compose ----------------------------------------------------------
# Read by compose.yml itself, not by the application.
# Published port of the frontend — the only published port of the stack.
# FRONTEND_PORT=8080
# Image tag to run. Pin a release rather than tracking "latest".
# DEIDENTIFIER_IMAGE_TAG=latest
