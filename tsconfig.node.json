{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "frontend/vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.screenshots.config.ts",
    "e2e/**/*.ts"
  ]
}
